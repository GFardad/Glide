{
  "name": "glide",
  "version": "0.1.0",
  "private": true,
  "description": "Glide — production-grade multi-agent mega harness",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages --ext .ts --ignore-pattern 'dist/**' --ignore-pattern 'coverage/**' --ignore-pattern 'node_modules/**' && eslint test --ext .ts",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "verify": "node scripts/verify-packages.mjs",
    "verify:deps": "node scripts/check-circular-deps.js",
    "clean": "pnpm -r clean",
    "glide": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "type": "module"
}
